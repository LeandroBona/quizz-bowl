    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "read-excel-file": "^9.3.12",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.6",
    "prisma": "6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
