{
  "name": "quiz-bowl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:user": "node --env-file=.env --import tsx scripts/admin-user.ts",
    "db:local": "sh scripts/start-local-mysql.sh",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/*.integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@radix-ui/react-dialog": "^1.1.15",
